#!/bin/bash
# Canonical future Python PBS stage. Add campaign-specific PBS directives above.

set -euo pipefail
: "${PYTHON:?set PYTHON to the pinned interpreter}"
: "${ENVIRONMENT_RECORD:?set ENVIRONMENT_RECORD to a persistent JSON path}"
: "${CAMPAIGN_COMMAND:?set CAMPAIGN_COMMAND to the stage command}"

export PYTHONNOUSERSITE=1
"$PYTHON" scripts/capture_campaign_environment.py \
    --stage pbs \
    --output "$ENVIRONMENT_RECORD"

exec "$PYTHON" $CAMPAIGN_COMMAND
