#!/bin/bash -l
#PBS -A QC_NA_Sim
#PBS -q compute
#PBS -l select=1:ncpus=128
#PBS -l place=scatter
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -r y

set -euo pipefail

ROOT=/lcrc/project/PIRT/NCS_GSEE_Benchmark/ml_agent/qb-gsee-benchmark
PYTHON=/scratch/ac.otten/NCS_GSEE_Benchmark_ml9c_pymc620/bin/python
RUN_MODE=${RUN_MODE:-smoke}
LOG_ROOT=/scratch/ac.otten/NCS_GSEE_Benchmark_ml9c_logs/${PBS_JOBID}

mkdir -p "$LOG_ROOT"
cd "$ROOT"

export PYTHONHASHSEED=0
export PYTHONPATH="$ROOT/src"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NUMBA_NUM_THREADS=1

echo "job_id=$PBS_JOBID"
echo "host=$(hostname)"
echo "run_mode=$RUN_MODE"
echo "root=$ROOT"
echo "python=$PYTHON"
"$PYTHON" -V
"$PYTHON" -c 'import pymc, arviz, pytensor; print(pymc.__version__, arviz.__version__, pytensor.__version__)'

if [[ "$RUN_MODE" == smoke ]]; then
    PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_ml9c_smoke" \
        "$PYTHON" -u - <<'PY'
from pathlib import Path

import numpy as np
import pymc as pm

from qb_gsee_benchmark.ml.bayesian_irt_run import _response_model, prepare_irt_data

root = Path.cwd()
data = prepare_irt_data(root, root / "analysis/ml9_bayesian_irt/preregistration.json")
model = _response_model(data, continuous=False)
with model:
    trace = pm.sample(
        tune=25,
        draws=25,
        chains=2,
        cores=1,
        random_seed=[2026073101, 2026073102],
        target_accept=0.95,
        progressbar=False,
        compute_convergence_checks=False,
        idata_kwargs={"log_likelihood": False},
    )
values = np.asarray(trace.posterior["task_difficulty"])
if values.shape != (2, 25, 96) or not np.isfinite(values).all():
    raise RuntimeError("ML-9C PBS smoke produced an invalid posterior array")
print(f"ML9C_PBS_SMOKE_PASS shape={values.shape}")
PY
    exit 0
fi

if [[ "$RUN_MODE" != production ]]; then
    echo "unsupported RUN_MODE=$RUN_MODE" >&2
    exit 2
fi

RUN_1="$ROOT/analysis/ml9_bayesian_irt/raw_runs/run_1"
RUN_2="$ROOT/analysis/ml9_bayesian_irt/raw_runs/run_2"
FINAL="$ROOT/analysis/ml9_bayesian_irt/final_v1"
IDENTITY="$ROOT/analysis/ml9_bayesian_irt/two_run_identity_v1.json"

PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_ml9c_run_1" \
    "$PYTHON" -u analysis/ml9_bayesian_irt/run_finalization.py \
    --output-dir "$RUN_1" >"$LOG_ROOT/run_1.log" 2>&1 &
PID_1=$!
PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_ml9c_run_2" \
    "$PYTHON" -u analysis/ml9_bayesian_irt/run_finalization.py \
    --output-dir "$RUN_2" >"$LOG_ROOT/run_2.log" 2>&1 &
PID_2=$!

set +e
wait "$PID_1"
STATUS_1=$?
wait "$PID_2"
STATUS_2=$?
set -e
echo "run_1_status=$STATUS_1"
echo "run_2_status=$STATUS_2"
tail -n 40 "$LOG_ROOT/run_1.log"
tail -n 40 "$LOG_ROOT/run_2.log"
if [[ "$STATUS_1" -ne 0 || "$STATUS_2" -ne 0 ]]; then
    exit 1
fi

"$PYTHON" -u analysis/ml9_bayesian_irt/verify_two_runs.py \
    --run-1 "$RUN_1" \
    --run-2 "$RUN_2" \
    --promote "$FINAL" \
    --identity "$IDENTITY"

echo "ML9C_PBS_PRODUCTION_PASS log_root=$LOG_ROOT"
