#!/bin/bash
#PBS -N ml9d_grouped_inference_v1
#PBS -A QC_NA_Sim
#PBS -l select=1:ncpus=128
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

ROOT="${PBS_O_WORKDIR:?}"
PYTHON="/home/ac.otten/soft/mambaforge/envs/qb_gsee/bin/python"
RUN_ROOT="$ROOT/analysis/ml9_grouped_inference/raw_runs"
LOG_ROOT="/scratch/ac.otten/NCS_GSEE_Benchmark_ml9d_logs/${PBS_JOBID:?}"

export PYTHONNOUSERSITE=1
export PYTHONHASHSEED=0
export PYTHONPATH="$ROOT/src"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

cd "$ROOT"
mkdir -p "$LOG_ROOT"

echo "job_id=$PBS_JOBID"
echo "host=$(hostname)"
echo "root=$ROOT"
echo "python=$PYTHON"
"$PYTHON" --version
"$PYTHON" -c 'import numpy, pandas, scipy, sklearn; print(numpy.__version__, pandas.__version__, scipy.__version__, sklearn.__version__)'

"$PYTHON" -u analysis/ml9_grouped_inference/run_finalization.py \
  --output-dir "$RUN_ROOT/run_1" >"$LOG_ROOT/run_1.log" 2>&1 &
pid_1=$!
"$PYTHON" -u analysis/ml9_grouped_inference/run_finalization.py \
  --output-dir "$RUN_ROOT/run_2" >"$LOG_ROOT/run_2.log" 2>&1 &
pid_2=$!

status=0
wait "$pid_1" || status=$?
wait "$pid_2" || status=$?
if [[ "$status" -ne 0 ]]; then
  tail -n 120 "$LOG_ROOT/run_1.log" || true
  tail -n 120 "$LOG_ROOT/run_2.log" || true
  exit "$status"
fi

tail -n 40 "$LOG_ROOT/run_1.log"
tail -n 40 "$LOG_ROOT/run_2.log"
"$PYTHON" analysis/ml9_grouped_inference/verify_two_runs.py \
  --run-1 "$RUN_ROOT/run_1" \
  --run-2 "$RUN_ROOT/run_2" \
  --promote "$ROOT/analysis/ml9_grouped_inference/final_v1" \
  --identity "$ROOT/analysis/ml9_grouped_inference/two_run_identity_v1.json"
