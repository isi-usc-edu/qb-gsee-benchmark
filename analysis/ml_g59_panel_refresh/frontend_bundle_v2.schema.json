{
  "$id": "https://gsee-benchmark.org/schemas/g59-solver-family-frontend-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "schema/index.schema.json"},
    "artifact_id": {"const": "g59_solver_family_frontend_v2"},
    "schema_version": {"const": "2.0.0"},
    "status": {"const": "complete_internal_descriptive_visualization_bundle"},
    "entrypoints": {"type": "object", "additionalProperties": {"type": "string"}},
    "release_scope": {"type": "object"},
    "semantics": {"type": "object"},
    "counts": {"type": "object"},
    "source": {"type": "object"},
    "prediction_chunks": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "solver_uuid": {"type": "string", "format": "uuid"},
          "solver_short_name": {"type": "string"},
          "solver_family_id": {"type": "string"},
          "path": {"type": "string"},
          "row_count": {"const": 1436}
        },
        "required": ["solver_uuid", "solver_short_name", "solver_family_id", "path", "row_count"]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "row_count": {"type": "integer", "minimum": 1}
        },
        "required": ["path", "role", "bytes", "sha256"]
      }
    }
  },
  "required": ["$schema", "artifact_id", "schema_version", "status", "entrypoints", "release_scope", "semantics", "counts", "source", "prediction_chunks", "files"],
  "type": "object"
}
